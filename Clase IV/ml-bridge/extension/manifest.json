{
  "manifest_version": 3,
  "name": "ML Price Bridge",
  "version": "1.0.0",
  "description": "Search Mercado Libre prices from Grok using your logged-in browser session.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ML Price Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://*.mercadolibre.com.ar/*",
    "https://*.mercadolibre.com.mx/*",
    "https://*.mercadolibre.com/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.cl/*",
    "https://*.mercadolibre.com.co/*",
    "https://*.mercadolibre.com.uy/*",
    "https://api.mercadolibre.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
